# .env.example — Copy to .env and fill in your values
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/healthcare_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=healthcare_db
DB_USER=postgres
DB_PASSWORD=YOUR_PASSWORD

# For Supabase (production)
SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Model settings
MODEL_PATH=ml/models/risk_model.pkl
N_PATIENTS=100
READINGS_PER_PATIENT=48
STREAM_INTERVAL_SECONDS=30